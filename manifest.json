{
  "manifest_version": 3,
  "name": "Rightmove Search Enhancer",
  "version": "1.0.0",
  "description": "Shows each property's total square footage on Rightmove search results, read from the listing, description, floorplan or brochure.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://*.rightmove.co.uk/*", "http://*.rightmove.co.uk/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.rightmove.co.uk/*", "http://*.rightmove.co.uk/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Rightmove Search Enhancer only works on rightmove.co.uk",
    "default_icon": {
      "16": "icons/icon16-disabled.png",
      "32": "icons/icon32-disabled.png",
      "48": "icons/icon48-disabled.png"
    }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
